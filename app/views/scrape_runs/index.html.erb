<% content_for :title, "Cinemapi | Backoffice | Scrape Runs" %>

<div class="flex items-center justify-between mb-5">
  <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Scrape Runs</h1>
  <% if @selected_date %>
    <%= link_to "← All days", scrape_runs_path, class: "text-sm text-gray-500 hover:text-red-600" %>
  <% else %>
    <%= link_to "Dashboard", backoffice_root_path, class: "text-sm text-gray-500 hover:text-red-600" %>
  <% end %>
</div>

<% if @selected_date %>
  <div class="flex items-center justify-between mb-4">
    <p class="text-sm text-gray-500 dark:text-gray-400">
      Showing runs for <span class="font-medium text-gray-700 dark:text-gray-200"><%= @selected_date.strftime("%d-%m-%Y") %></span>
    </p>
    <%= link_to "Export failures JSON", export_failures_by_date_scrape_runs_path(date: @selected_date.to_s),
        class: "text-xs px-3 py-1.5 rounded border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700" %>
  </div>
  <% if @scrape_runs.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="text-xs uppercase tracking-wide text-gray-400 dark:text-gray-500 border-b border-gray-200 dark:border-gray-700">
            <th class="text-left py-2 pr-4 font-medium">Date</th>
            <th class="text-left py-2 pr-4 font-medium">Theater</th>
            <th class="text-left py-2 pr-4 font-medium">Status</th>
            <th class="text-left py-2 pr-4 font-medium">OK</th>
            <th class="text-left py-2 pr-4 font-medium">Failed</th>
            <th class="py-2"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
          <% @scrape_runs.each do |run| %>
            <tr>
              <td class="py-2 pr-4 font-mono text-xs text-gray-500"><%= run.created_at.strftime("%d-%m-%Y %H:%M") %></td>
              <td class="py-2 pr-4"><%= run.theater.name %></td>
              <td class="py-2 pr-4">
                <% color = { "success" => "text-green-600", "failed" => "text-red-600", "running" => "text-yellow-600" }[run.status] %>
                <span class="font-medium <%= color %>"><%= run.status %></span>
              </td>
              <td class="py-2 pr-4"><%= run.items_ok %></td>
              <td class="py-2 pr-4 <%= "text-red-600 font-medium" if run.items_failed.positive? %>"><%= run.items_failed %></td>
              <td class="py-2"><%= link_to "View", scrape_run_path(run), class: "text-red-600 hover:underline" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-sm text-gray-400 dark:text-gray-500 py-10 text-center">No scrape runs for this day.</p>
  <% end %>

<% else %>
  <% if @days.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="text-xs uppercase tracking-wide text-gray-400 dark:text-gray-500 border-b border-gray-200 dark:border-gray-700">
            <th class="text-left py-2 pr-4 font-medium">Date</th>
            <th class="text-left py-2 pr-4 font-medium">Total OK</th>
            <th class="text-left py-2 pr-4 font-medium">Total Failed</th>
            <th class="py-2"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
          <% @days.each do |d| %>
            <tr>
              <td class="py-2 pr-4 font-mono text-xs text-gray-500"><%= Date.parse(d.day).strftime("%d-%m-%Y") %></td>
              <td class="py-2 pr-4"><%= d.total_ok %></td>
              <td class="py-2 pr-4 <%= "text-red-600 font-medium" if d.total_failed.to_i.positive? %>"><%= d.total_failed %></td>
              <td class="py-2"><%= link_to "View", scrape_runs_path(date: d.day), class: "text-red-600 hover:underline" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-sm text-gray-400 dark:text-gray-500 py-10 text-center">No scrape runs yet.</p>
  <% end %>
<% end %>
